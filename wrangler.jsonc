{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ads-iscte-frontend",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-01-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    },
  },
  "vars": {
    "NEXT_PUBLIC_API_BASE": "https://ads-iscte-backend.onrender.com",
    "NEXT_PUBLIC_GITHUB_AUTHENTICATION_ENDPOINT_URL": "/auth/github",
    "NEXT_PUBLIC_DASHBOARD_BASE_ENDPOINT_URL": "/github/dashboard",
    "NEXT_AUTH_TOKEN_NAME": "ghdashauth"
  }
}